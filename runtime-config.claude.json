{
  "name": "claude-role-runtime",
  "default": {
    "command": [
      "{python_executable}",
      "{workspace_root}/scripts/nexus_claude_role_runtime.py",
      "--payload-file",
      "{payload_file}",
      "--prompt-file",
      "{prompt_file}",
      "--claude-command",
      "claude",
      "--permission-mode",
      "bypassPermissions",
      "--allowed-tools",
      "Read",
      "Write",
      "Edit",
      "Bash"
    ],
    "cwd": "{workspace_root}",
    "timeoutSeconds": 900
  }
}
