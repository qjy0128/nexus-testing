{
  "name": "openclaw-role-runtime",
  "default": {
    "command": [
      "{python_executable}",
      "{workspace_root}/scripts/nexus_openclaw_role_runtime.py",
      "--payload-file",
      "{payload_file}",
      "--prompt-file",
      "{prompt_file}",
      "--openclaw-command",
      "openclaw",
      "--skill-path",
      ".",
      "--channel",
      "telegram"
    ],
    "cwd": "{workspace_root}",
    "timeoutSeconds": 900,
    "stallTimeoutSeconds": 300
  }
}
